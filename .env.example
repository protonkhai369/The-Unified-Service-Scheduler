# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
#
# Supabase: Dashboard -> Connect -> "Session pooler" (works over IPv4; the direct
# db.<ref>.supabase.co host is IPv6-only). Avoid the transaction pooler (port 6543): it does not
# support the prepared statements Hibernate and Flyway rely on.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>
#
# Supabase Auth: Dashboard -> Project Settings -> API. The backend needs only the URL: it verifies
# access tokens with the project's public signing keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Used only by scripts/supabase-demo-users.sh and to fetch tokens with cURL, never by the backend.
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
SUPABASE_SECRET_KEY=<sb_secret_...>
#
# Without a .env file the application falls back to a local PostgreSQL:
# jdbc:postgresql://localhost:5432/scheduler (user/password: scheduler)
